# RPC and public vault settings
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ASSET=native
VAULT_ID=
READ_ACCOUNT=
WATCH_START_LEDGER=

# PostgreSQL connection for the watcher and anchor adapter
DATABASE_URL=postgres://muxvault:muxvault@127.0.0.1:5432/muxvault

# Public role addresses for deployment. Admin defaults to the deployer's address.
ADMIN_ADDRESS=
FUNDING_ADDRESS=
GUARDIAN_ADDRESS=

# Supply Testnet-only seeds privately at runtime.
DEPLOYER_SEED=
MUXVAULT_SIGNER_SEED=

# Controlled SEP-24 fixture. Keep the token private.
ANCHOR_NAMESPACE=muxvault-mock
ANCHOR_MOCK_URL=http://127.0.0.1:4242
ANCHOR_MOCK_PORT=4242
ANCHOR_MOCK_TOKEN=
MOCK_PAYMENT_ID=deposit-1
MOCK_CUSTOMER_ID=1
MOCK_ASSET_AMOUNT=0.3
