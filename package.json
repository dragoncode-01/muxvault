{
  "name": "muxvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:logic": "node --test tests/logic.test.ts",
    "typecheck": "tsc --noEmit",
    "operator": "node --env-file-if-exists=.env scripts/operator.ts",
    "watch": "node --env-file-if-exists=.env services/event-watcher/src/main.ts",
    "anchor:mock": "node --env-file-if-exists=.env services/anchor-adapter/src/mock.ts",
    "deploy:testnet": "node --env-file-if-exists=.env scripts/deploy-testnet.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "web": "vite frontend",
    "web:build": "vite build frontend --base ./",
    "web:preview": "vite preview frontend"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.3.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@stellar/freighter-api": "6.0.1",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
